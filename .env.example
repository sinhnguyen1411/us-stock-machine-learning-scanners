# ═══════════════════════════════════════════════════════════════════════════
# BINANCE FUTURES (USDT-M) & BYBIT PUMP SCANNER CONFIGURATION
# Copy to .env and adjust parameters as needed
# ═══════════════════════════════════════════════════════════════════════════

# --- Exchange API Credentials ---
# Set SIMULATION_MODE=true to run paper trading (no API keys required!)
SIMULATION_MODE=true
INITIAL_SIMULATION_EQUITY=1000.0   # Virtual USDT equity for paper trading

# Binance Futures API (Required if SIMULATION_MODE=false)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=false              # Set to true for Binance Futures Testnet

# Bybit API (For Bybit Pump Scanner)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=false

# --- Detection Thresholds ---
PUMP_SCAN_INTERVAL=3               # Scan cycle every 3 seconds
PUMP_VOL_SPIKE_MULT=5.0            # 5x normal volume = potential pump
PUMP_PRICE_SPIKE_PCT=0.03          # 3% price move in 5-candle window
PUMP_PRICE_WINDOW=5                # 5 scan cycles window for price change
PUMP_MIN_DOLLAR_VOL=500000         # Ignore coins with < $500k 24h volume
PUMP_MIN_24H_CHANGE_PCT=5.0        # Fast-filter threshold for 24h change (%)

# --- Fakeout Filters (7 Layers) ---
PUMP_CONFIRM_CANDLES=3             # Need 3 consecutive green candles
PUMP_MIN_RSI_ENTRY=60              # RSI must be > 60 (momentum)
PUMP_MAX_RSI_ENTRY=85              # RSI must be < 85 (not over-exhausted)
PUMP_MIN_BUY_RATIO=0.65           # 65%+ buy-side taker volume
PUMP_MIN_OI_CONFIRM=true           # Require Open Interest increase for pump long

# --- Position Sizing & Leverage ---
PUMP_LEVERAGE=5                    # Leverage for pump trades (5x)
PUMP_RISK_BUDGET_PCT=0.05          # 5% of equity per trade
PUMP_MAX_POSITIONS=2               # Max simultaneous trades
PUMP_MIN_NOTIONAL=5.0              # Minimum notional order size ($5)

# --- Take Profit / Stop Loss Strategy ---
PUMP_SL_ATR_MULT=1.5               # SL = 1.5x ATR below entry
PUMP_TP1_PCT=0.05                  # +5% -> close 40%, move SL to breakeven
PUMP_TP2_PCT=0.10                  # +10% -> close 30%, activate trailing stop
PUMP_TP3_PCT=0.20                  # +20% -> close remaining 30%
PUMP_TRAILING_PCT=0.03             # 3% trailing stop from peak after TP2
PUMP_MAX_HOLD_SEC=7200             # 2 hours max holding time

# --- Dump Short Settings (Exhaustion Detection) ---
PUMP_SHORT_RSI=80                  # RSI > 80 for short entry
PUMP_SHORT_VOL_DECLINE=0.40        # 40% volume decline from peak
PUMP_SHORT_FUNDING=0.001           # Funding rate > 0.1% = extreme long bias
PUMP_SHORT_SL_ATR=2.0              # 2.0x ATR for short stop loss
PUMP_SHORT_TP_PCT=0.05             # 5% TP on short

# --- New Listing Detection ---
PUMP_LISTING_CHECK=30              # Check for new listings every 30s
PUMP_LISTING_DELAY=5               # Wait 5s after detection to stabilize
PUMP_LISTING_RISK=0.02             # 2% equity for new listing trade

# --- Risk Circuit Breaker & Cooldown ---
PUMP_COOLDOWN_SEC=1800             # 30 min cooldown per coin after exit
PUMP_MAX_DAILY_LOSS=-50            # Stop trading if daily loss reaches -$50

# --- Telegram Alerts ---
TELEGRAM_TOKEN=                    # Bot token from @BotFather
TELEGRAM_CHAT_ID=                  # Your chat/group ID
